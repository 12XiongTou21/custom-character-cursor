; Pudding Sword cursor theme -- generated by cursor-studio cursorgen
; artist: cursor-studio
; generated by cursor-studio sword_theme
;
; Right-click this file and choose "Install" to add the
; scheme, then pick it under Mouse Properties > Pointers.

[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%Arrow%,%10%\%CUR_DIR%\%Help%,%10%\%CUR_DIR%\%AppStarting%,%10%\%CUR_DIR%\%Wait%,%10%\%CUR_DIR%\%Crosshair%,%10%\%CUR_DIR%\%IBeam%,%10%\%CUR_DIR%\%NWPen%,%10%\%CUR_DIR%\%No%,%10%\%CUR_DIR%\%SizeNS%,%10%\%CUR_DIR%\%SizeWE%,%10%\%CUR_DIR%\%SizeNWSE%,%10%\%CUR_DIR%\%SizeNESW%,%10%\%CUR_DIR%\%SizeAll%,%10%\%CUR_DIR%\%UpArrow%,%10%\%CUR_DIR%\%HandCursor%"

[Scheme.Cur]
01 Arrow.ani
02 Help.ani
03 AppStarting.ani
04 Wait.ani
05 Crosshair.ani
06 IBeam.ani
07 NWPen.ani
08 No.ani
09 SizeNS.ani
10 SizeWE.ani
11 SizeNWSE.ani
12 SizeNESW.ani
13 SizeAll.ani
14 UpArrow.ani
15 Hand.ani

[Scheme.Txt]

[Strings]
CUR_DIR     = "Cursors\Pudding Sword Cursor"
SCHEME_NAME = "Pudding Sword Cursor"
Arrow       = "01 Arrow.ani"
Help        = "02 Help.ani"
AppStarting = "03 AppStarting.ani"
Wait        = "04 Wait.ani"
Crosshair   = "05 Crosshair.ani"
IBeam       = "06 IBeam.ani"
NWPen       = "07 NWPen.ani"
No          = "08 No.ani"
SizeNS      = "09 SizeNS.ani"
SizeWE      = "10 SizeWE.ani"
SizeNWSE    = "11 SizeNWSE.ani"
SizeNESW    = "12 SizeNESW.ani"
SizeAll     = "13 SizeAll.ani"
UpArrow     = "14 UpArrow.ani"
Hand        = "15 Hand.ani"

; ---- legacy aliases: keeps one-click installer scripts working ----
; (same files as above; hand = NWPen slot 7, link = Hand slot 15)
pointer      = "01 Arrow.ani"
help         = "02 Help.ani"
work         = "03 AppStarting.ani"
busy         = "04 Wait.ani"
cross        = "05 Crosshair.ani"
text         = "06 IBeam.ani"
hand         = "07 NWPen.ani"
unavailiable = "08 No.ani"
vert         = "09 SizeNS.ani"
horz         = "10 SizeWE.ani"
dgn1         = "11 SizeNWSE.ani"
dgn2         = "12 SizeNESW.ani"
move         = "13 SizeAll.ani"
alternate    = "14 UpArrow.ani"
link         = "15 Hand.ani"

; ---- our own [Scheme.Reg] name for slot 15 (see the note above) ----
HandCursor  = "15 Hand.ani"
